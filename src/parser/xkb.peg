start <- variant*

GENERIC_FLAG <- "partial"
              | "default"
              | "hidden"
SYMBOLS_FLAG <- "alphanumeric_keys"
              | "modifier_keys"
              | "keypad_keys"
              | "function_keys"
              | "alternate_group"
FLAG <- < GENERIC_FLAG / SYMBOLS_FLAG >

variant <- FLAG* "xkb_symbols" id "{" statement* "}" ";"

statement <- name
           / include
           / key_type_default
           / key
           / modifier_map
           / virtual_modifiers

id <- < STRING >
name <- "name" "[" GROUP "]"       "=" < STRING > ";"
      / "groupName" "[" [0-9]+ "]" "=" < STRING >";"

include <- "include" < STRING >

# https://xkbcommon.org/doc/current/keymap-text-format-v1-v2.html#set-real-mod-map
modifier_map <- "modifier_map" MODIFIER "{" (KEYCODE / KEYSYM) ("," (KEYCODE / KEYSYM))* "}" ";"

# TODO: I do not care to actually do anything with this one, so it's a stub
virtual_modifiers <- < "virtual_modifiers" IDENT ";" >

key <- MERGEMODE? "key" KEYCODE key_props ";"

key_props <- "{" key_prop? ("," key_prop)* "}"

key_prop <- key_syms
          / key_type
          / key_acts
          / repeat
          / key_virtmod
          / overlay

key_syms <- ("symbols" ("[" GROUP "]")? "=")? "[" KEYSYM? ("," KEYSYM)* "]"
key_type <- "type" ("[" GROUP "]")? "=" KEYTYPE
key_acts <- "actions" ("[" GROUP "]")? "=" "[" action ("," action)* "]"
action <- ACTION "(" .* ")"
repeat <- "repeat" "=" BOOL
key_virtmod <- ("virtualModifiers" / "virtualMods") "=" IDENT
# https://xkbcommon.org/doc/current/keymap-text-format-v1-v2.html#the-xkb_symbols-section under Type section
key_type_default <- "key.type" "[" GROUP "]" "=" < STRING > ";"

# DEPRECATED
overlay <- "overlay" ("1" / "2") "=" KEYCODE

BOOL <- "True" / "False"

MERGEMODE <- "override"
           | "augment"
           | "replace"
           | "alternate"

# https://xkbcommon.org/doc/current/keymap-text-format-v1-v2.html#virtual-modifier-def
MODIFIER <- "None"
          | "Shift"
          | "Lock"
          | "Control"
          | "Mod1"
          | "Mod2"
          | "Mod3"
          | "Mod4"
          | "Mod5"
          | "Alt"
          | "Meta"
          | "NumLock"
          | "Super"
          | "LevelThree"
          | "LevelFive"

# https://xkbcommon.org/doc/current/keymap-text-format-v1-v2.html#key-actions
ACTION <- "NoAction"
        | "VoidAction"
        | "SetMods"
        | "LatchMods"
        | "LockMods"
        | "SetGroup"
        | "LatchGroup"
        | "LockGroup"
        | "MovePointer"
        | "PointerButton"
        | "LockPointerButton"
        | "SetPointerDefault"
        | "SetControls"
        | "TerminateServer"
        | "SwitchScreen"
        | "Private"
        | "RedirectKey"
        | "ISOLock"
        | "DeviceButton"
        | "LockDeviceButton"
        | "DeviceValuator"
        | "MessageAction"

HEX             <- < "0x" [a-zA-Z0-9]+ >
KEYTYPE         <- < STRING >
KEYCODE         <- < "<" (IDENT / "+" / "-")* ">" >
KEYSYM          <- < HEX / IDENT / STRING >
IDENT           <- < [a-zA-Z0-9_]+ >
~GROUP          <- < [Gg]"roup" "1" >
STRING          <- < '"' (!'"' .)* '"' >

~COMMENT <- "//" (!'\n' .)*
%whitespace <- ([ \n\t] / COMMENT)*
%word <- [a-zA-Z_]+
